# AF-03 Environment Variables Configuration

# API Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
WEB_URL=http://localhost:5173

# AI Agent Provider Configuration
# Supported: gemini, anthropic, openai, mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-3-5-haiku-20241022

# Workspace Storage
WORKSPACE_ROOT_PATH=./AF03_Workspace
MAX_DOWNLOAD_FILE_SIZE_MB=15

# Email Reminder Service (part 8)
EMAIL_PROVIDER=mock # mock or smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@af03-skillgapper.internal
INACTIVITY_THRESHOLD_DAYS=7

