# AF-03 Environment Variables Configuration

# API Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
WEB_URL=http://localhost:5173

# AI Agent Provider Configuration
# Supported AI_PROVIDER values: groq, claude, mock
AI_PROVIDER=groq

# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Currently supported Groq models for structured output:
# - llama-3.3-70b-versatile (Recommended: 70B parameter model with strong reasoning & JSON adherence)
# - llama-3.1-8b-instant (Fast, lower-latency alternative)
GROQ_MODEL=llama-3.3-70b-versatile

# Claude / Anthropic Provider (Future extension point)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Workspace Storage
WORKSPACE_ROOT_PATH=./AF03_Workspace
MAX_DOWNLOAD_FILE_SIZE_MB=15

# Email Reminder Service
EMAIL_PROVIDER=mock # mock or smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@af03-skillgapper.internal
INACTIVITY_THRESHOLD_DAYS=7
